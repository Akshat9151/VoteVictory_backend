DEBUG=true
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
OTP_EXPIRE_MINUTES=15
OTP_MAX_ATTEMPTS=5
# ==============================================================================
# ENVIRONMENT CONFIGURATION - VOTING MANAGEMENT SYSTEM BACKEND
# ==============================================================================

# Application Environment
PROJECT_NAME="Voting & Election Management System"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
SECRET_KEY="generate-a-secure-256-bit-random-secret-key-for-production"
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5500", "http://localhost:8000"]

# Database Configuration (PostgreSQL)
# Neon example format (replace with your project values; do not commit real credentials):
# DATABASE_URL="postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"
# DATABASE_SYNC_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"
DATABASE_URL="postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"
DATABASE_SYNC_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Redis Cache & Session Store
REDIS_URL="redis://localhost:6379/0"
REDIS_SESSION_TTL_SECONDS=604800 # 7 days
RATE_LIMIT_PER_MINUTE=120

# Celery Worker Configuration
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Security & JWT Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM="HS256"
PASSWORD_HASH_SCHEME="argon2" # argon2 or bcrypt
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Initial Super Admin Bootstrap (Created on startup if not exists)
FIRST_SUPER_ADMIN_EMAIL="superadmin@electwin.com"
FIRST_SUPER_ADMIN_PASSWORD="SuperSecureAdminPassword123!"
FIRST_SUPER_ADMIN_FIRST_NAME="Super"
FIRST_SUPER_ADMIN_LAST_NAME="Administrator"

# Storage Settings (Local / S3)
STORAGE_BACKEND="local" # local or s3
LOCAL_STORAGE_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# External Notification Providers
# SMS Provider (e.g., Twilio or Mock)
SMS_PROVIDER="mock" # mock | twilio | msg91 | aws_sns
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
# Required when WHATSAPP_PROVIDER=twilio: an approved WhatsApp-enabled sender number, without the whatsapp: prefix.
TWILIO_WHATSAPP_FROM_NUMBER=""

# WhatsApp Provider (Meta Cloud API)
WHATSAPP_PROVIDER="mock" # mock | twilio | meta_cloud
META_WHATSAPP_ACCESS_TOKEN=""
META_WHATSAPP_PHONE_NUMBER_ID=""
META_WHATSAPP_BUSINESS_ACCOUNT_ID=""
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN="meta-webhook-verify-token-secret"
META_WHATSAPP_APP_SECRET=""

# Instagram Messaging Provider (Meta Graph API)
INSTAGRAM_PROVIDER="mock" # mock | meta_instagram
META_INSTAGRAM_PAGE_ACCESS_TOKEN=""
META_INSTAGRAM_PAGE_ID=""
META_INSTAGRAM_APP_SECRET=""

# Webhook Secrets
WEBHOOK_SECRET_SMS="sms-webhook-secret-key"
WEBHOOK_SECRET_WHATSAPP="whatsapp-webhook-secret-key"
WEBHOOK_SECRET_INSTAGRAM="instagram-webhook-secret-key"
