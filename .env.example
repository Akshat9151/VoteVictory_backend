# ==============================================================================
# ENVIRONMENT CONFIGURATION - VOTING MANAGEMENT SYSTEM BACKEND (.env.example)
# ==============================================================================

# Application Environment
PROJECT_NAME="Voting & Election Management System"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
SECRET_KEY="generate-a-secure-256-bit-random-secret-key-for-production"
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5500", "http://localhost:8000"]

# Database Configuration (PostgreSQL / Neon / SQLite)
DATABASE_URL="postgresql+asyncpg://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME?sslmode=require"
DATABASE_SYNC_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME?sslmode=require"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Redis Cache & Session Store
REDIS_URL="redis://localhost:6379/0"
REDIS_SESSION_TTL_SECONDS=604800
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=15
RATE_LIMIT_BROADCAST_PER_MINUTE=10
AUDIENCE_SPLIT_CACHE_TTL_SECONDS=300

# Celery Worker Configuration
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Security & JWT Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM="HS256"
PASSWORD_HASH_SCHEME="argon2"
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Super Admin Initial Bootstrap
FIRST_SUPER_ADMIN_PHONE="+1234567890"
FIRST_SUPER_ADMIN_EMAIL="admin@example.com"
FIRST_SUPER_ADMIN_PASSWORD="YourSecureAdminPassword123!"
FIRST_SUPER_ADMIN_FIRST_NAME="Super"
FIRST_SUPER_ADMIN_LAST_NAME="Administrator"

# Storage Settings (local | s3)
STORAGE_BACKEND="local"
LOCAL_STORAGE_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# Email Provider Configuration (mock | smtp | resend | brevo | sendgrid)
EMAIL_PROVIDER="mock"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USERNAME="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM_EMAIL="noreply@example.com"
BREVO_API_KEY=""
RESEND_API_KEY=""
SENDGRID_API_KEY=""

# SMS Provider Configuration (mock | twilio | msg91 | aws_sns)
SMS_PROVIDER="mock"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_WHATSAPP_FROM_NUMBER=""

# WhatsApp Provider Configuration (mock | twilio | meta_cloud)
WHATSAPP_PROVIDER="mock"
META_WHATSAPP_ACCESS_TOKEN=""
META_WHATSAPP_PHONE_NUMBER_ID=""
META_WHATSAPP_BUSINESS_ACCOUNT_ID=""
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN="your-meta-webhook-verify-token"
META_WHATSAPP_APP_SECRET=""

# Instagram Messaging Provider (mock | meta_instagram)
INSTAGRAM_PROVIDER="mock"
META_INSTAGRAM_PAGE_ACCESS_TOKEN=""
META_INSTAGRAM_PAGE_ID=""
META_INSTAGRAM_APP_SECRET=""

# Webhook Secrets
WEBHOOK_SECRET_SMS="your-sms-webhook-secret"
WEBHOOK_SECRET_WHATSAPP="your-whatsapp-webhook-secret"
WEBHOOK_SECRET_INSTAGRAM="your-instagram-webhook-secret"

# Google OAuth Configuration
GOOGLE_CLIENT_ID=""
